pipeline {
  agent any

  options {
    timestamps()
    timeout(time: 1, unit: 'HOURS')
  }

  parameters {
    string(name: 'DOCKER_IMAGE', defaultValue: 'mario21ic/python-calc', description: 'Docker image')
    string(name: 'DOCKER_CREDENTIALS', defaultValue: 'dockerhub_credentials', description: 'Credentials on Docker Hub organization')
    string(name: 'SLACK_CHANNEL', defaultValue: 'jenkins-blazingsql', description: '')
    string(name: 'SONAR_ORGANIZATION', defaultValue: 'project-u201421533', description: 'SonarCloud organization key')
    string(name: 'SONAR_PROJECT_KEY', defaultValue: 'project-u201421533_python-calc', description: 'SonarCloud project key')
    string(name: 'SONAR_CREDENTIALS', defaultValue: 'sonarcloud_token', description: 'Jenkins credential id (Secret text) with the SonarCloud token')
    booleanParam(name: 'DEPLOY', defaultValue: false, description: 'Deploy to Kubernetes after publishing the image')
    string(name: 'K8S_NAMESPACE', defaultValue: 'default', description: 'Kubernetes namespace to deploy to')
    string(name: 'KUBECONFIG_CREDENTIALS', defaultValue: 'kubeconfig', description: 'Jenkins credential id (Secret file) with the kubeconfig')
  }

  environment {
    DOCKER_IMAGE_VERSION = "${params.DOCKER_IMAGE}-v${env.BUILD_NUMBER}"
    SLACK_MESSAGE=" - Job '${env.JOB_NAME}' - Build #${env.BUILD_NUMBER}: ${env.BUILD_URL}"
  }

  stages {

    stage("Repository") {
      steps {
        checkout scm
      }
    }

    stage("Unit tests") {
      steps {
        sh "./docker-unittest.sh"
      }
    }

    stage("Integration tests") {
      steps {
        sh "./docker-integration-test.sh"
      }
    }

    stage("Secret scan") {
      steps {
        sh "./docker-gittyleaks.sh ./src/ || true" 
      }
    }

    stage("SAST") {
      steps {
        sh "./docker-bandit.sh src || true"
      }
    }

    stage("SCA") {
      steps {
        sh "./docker-pip-audit.sh requirements.txt || true"
      }
    }

    stage("Sonar scan") {
      steps {
        script {
          try {
            withCredentials([string(credentialsId: "${params.SONAR_CREDENTIALS}", variable: 'SONAR_TOKEN')]) {
              sh "./docker-sonar.sh ${params.SONAR_ORGANIZATION} ${params.SONAR_PROJECT_KEY}"
            }
          } catch (e) {
            echo "Credencial '${params.SONAR_CREDENTIALS}' no encontrada. Omitiendo Sonar scan."
          }
        }
      }
    }

    stage("Kubernetes manifest scan") {
      steps {
        sh "./docker-kubesec.sh k8s/deployment.yaml"
      }
    }

    stage("Docker build") {
      steps {
        sh "docker build -t ${env.DOCKER_IMAGE_VERSION} ./"
      }
    }

    stage("E2E tests") {
      steps {
        sh "./docker-e2e-test.sh ${env.DOCKER_IMAGE_VERSION}"
      }
    }

    stage("Image security") {
      parallel {
        stage("SBOM") {
          steps {
            sh "./docker-syft.sh ${env.DOCKER_IMAGE_VERSION}"
          }
        }
        stage("Scan") {
          steps {
            sh "./docker-trivy.sh ${env.DOCKER_IMAGE_VERSION} || true"
          }
        }
        stage("ClamAV") {
          steps {
            sh "./docker-clamav.sh ${env.DOCKER_IMAGE_VERSION}"
          }
        }
      }
    }

    stage("DAST") {
      steps {
        sh "./docker-zap.sh ${env.DOCKER_IMAGE_VERSION} || true"
      }
    }

    stage("Publish image") {
      steps {
        withCredentials([usernamePassword(credentialsId: "${params.DOCKER_CREDENTIALS}", passwordVariable: 'PASSWORD', usernameVariable: 'USERNAME')]) {
          sh "echo $PASSWORD | docker login -u $USERNAME --password-stdin"
        }

        sh "docker push ${env.DOCKER_IMAGE_VERSION}"
      }
    }

    stage("Deploy to Kubernetes") {
      when {
        expression { return params.DEPLOY }
      }
      steps {
        withCredentials([file(credentialsId: "${params.KUBECONFIG_CREDENTIALS}", variable: 'KUBECONFIG_FILE')]) {
          sh "./docker-k8s-deploy.sh ${env.DOCKER_IMAGE_VERSION} ${params.K8S_NAMESPACE} \$KUBECONFIG_FILE"
        }
      }
    }

  }

  post {
    always {
      script {
        // slackSend(channel: "${params.SLACK_CHANNEL}", color: '#FFFF00', message: " - Job '${env.JOB_NAME}' - Build #${env.BUILD_NUMBER}: ${env.BUILD_URL}")
        archiveArtifacts artifacts: 'zap-reports/*.html', allowEmptyArchive: true
        sh "docker logout"
      }
    }
  }
}
